# The web UI has no login of its own: publish it only through your authenticating reverse proxy.

# Service account for PowerShell remoting to the VBR server.
# Needs: local admin / Remote Management Users on VBR + Veeam Backup Administrator role.
VBR_USERNAME=ARC\svc-hvbo
VBR_PASSWORD=change-me

# Service account for PowerShell remoting to SCVMM. Needs a VMM read-only administrator
# (or Administrator) user role scoped to the tenant clouds.
SCVMM_USERNAME=ARC\svc-hvbo
SCVMM_PASSWORD=change-me

# Set to true to run against a built-in demo estate without touching anything.
HVBO_MOCK=false
